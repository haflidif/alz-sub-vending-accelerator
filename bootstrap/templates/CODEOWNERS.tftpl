# CODEOWNERS for sub-vending
#
# Rendered by `bootstrap/files.tf` from `bootstrap/templates/CODEOWNERS.tftpl`.
# Re-run the bootstrap (or update via PR directly) to change owners.

# Default owners — apply to everything that isn't specifically overridden.
*                                   ${default_team}

# Selected engine - locked down to the default team.
%{ if starter_name == "terraform" ~}
/terraform/                         ${default_team}
%{ else ~}
/bicep/                             ${default_team}
%{ endif ~}
/.github/                           ${default_team}
/docs/                              ${default_team}
%{ for archetype, owners in archetype_owners ~}

# ${archetype} archetype
/landingzones/${archetype}/         ${join(" ", owners)}
%{ endfor ~}
